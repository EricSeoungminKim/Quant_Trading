# 리포트 정적 서빙 — **Tailscale 인터페이스에만 바인딩한다.**
#
# 공개 포트를 열지 않는 게 이 설계의 핵심이다. 이 박스에는 실거래 시크릿이
# 있으므로 인터넷에 노출할 표면을 만들지 않는다. 나중에 Vercel 로 out/ 을
# 밀어내더라도 이 유닛은 tailnet 전용으로 남긴다.
#
# 루트는 out/ **하나뿐**이다 — 저장소 루트를 서빙하면 .env.local 이 그대로
# 노출된다(회사 리포트 서버가 디렉토리 리스팅이 열려 있던 사례를 반복하지 않는다).
[Unit]
Description=Market report static server (tailnet only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/quant_trading_kiwoom/out
Environment=TZ=Asia/Seoul
# BIND_ADDR 은 이 호스트의 tailnet IP. 바뀌면 여기만 고친다.
Environment=BIND_ADDR=100.87.129.113
ExecStart=/usr/bin/python3 -m http.server 8899 --bind ${BIND_ADDR} --directory /home/ubuntu/quant_trading_kiwoom/out
Restart=on-failure
RestartSec=10

MemoryMax=120M
CPUQuota=10%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

# **시크릿을 이 프로세스에서 읽을 수 없게 못 박는다.** 2026-08-13 저장소 통합
# 전에는 리포트가 별도 체크아웃이라 거래 시크릿이 구조적으로 손에 닿지 않았다.
# 이제 같은 디렉토리에 있으므로 커널이 막게 한다 — 이 유닛은 EnvironmentFile 이
# 없고 out/ 만 서빙하지만, 공개 노출되는 유일한 프로세스라 이중으로 잠근다.
InaccessiblePaths=/home/ubuntu/quant_trading_kiwoom/.env.local
InaccessiblePaths=/home/ubuntu/quant_trading_kiwoom/data/state

[Install]
WantedBy=multi-user.target
