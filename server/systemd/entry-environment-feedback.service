[Unit]
Description=Evaluate frozen KR premarket environment against exact-session indices
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/quant_trading_kiwoom
ExecStart=/home/ubuntu/quant_trading_kiwoom/.venv/bin/python -m quant.apps.entry_environment --root /home/ubuntu/quant_trading_kiwoom
Environment=TZ=Asia/Seoul
Environment=OPENBLAS_NUM_THREADS=1
Nice=10
CPUQuota=25%
MemoryMax=350M
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal
