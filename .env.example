# 복사해서 .env.local 로 저장 (gitignored). 서버에는 scp로 전달.

# --- 실행 모드: paper | live ---
MODE=paper

# --- Toss Securities Open API (Phase 1 라이브 브로커 + 실계좌 진단) ---
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=

# --- Kiwoom REST API (Phase 3: KR + websocket 실시간 피드) ---
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=
# 모의투자 API KEY
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=
# 해외증권 계좌 API KEY (위탁 계좌 앱과 별도 발급 — 미국주식 등 해외 조회/매매용.
# 2026-08-10 기준 미발급: 기존 실전 앱은 위탁 5483-8963만 커버)
KIWOOM_GLOBAL_APP_KEY=
KIWOOM_GLOBAL_SECRET_KEY=
KIWOOM_GLOBAL_ACCOUNT_NO=
# [미사용 — 2026-08-26 확인] 이 값을 읽는 코드가 저장소에 없다. 키움은 데이터
# 전용이고 주문은 Toss 단일 경로다(TOSS_ACCOUNT_SEQ 를 쓴다). 실제로 쓰게 되는
# 날 되살리되, 그때까지 "설정했는데 왜 안 되지"를 만들지 않도록 표시해 둔다.
KIWOOM_ACCOUNT_NO=
# 모의투자: https://mockapi.kiwoom.com / 실전: https://api.kiwoom.com
KIWOOM_BASE_URL=https://mockapi.kiwoom.com

# 보유 계좌 목록 (참고용 — 코드가 직접 읽지 않음)
KIWOOM_MOCK_ACCOUNT_KR=
KIWOOM_MOCK_ACCOUNT_FUTURES=
KIWOOM_MOCK_ACCOUNT_SHORT=
KIWOOM_REAL_ACCOUNT_NO=

# --- Alpaca Markets (fetch --source alpaca: 무료 IEX feed, 분봉 ~2016년까지) ---
# 발급: https://alpaca.markets 무료 가입 → Paper Trading 계정의 API Keys에서 생성
# (계정 생성은 사용자 본인 작업 — 코드가 대신 만들지 않음). IEX feed는 consolidated
# 거래량의 일부라 volume 절대값 비교엔 부적합 — docs/data-availability.md 참고.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Telegram: 알림 봇 (일방향) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Telegram: Claude 브릿지 봇 (양방향, 별도 봇) ---
TELEGRAM_BRIDGE_BOT_TOKEN=
TELEGRAM_BRIDGE_CHAT_ID=

# --- 자본 ---
START_CAPITAL_KRW=10000000


# ============================================================
# 리포트·수집 평면 (2026-08-13 저장소 통합으로 편입)
# ============================================================
# ⚠️ 격리 주의: 리포트 웹서버(market-report-web.service)는 Tailscale Funnel 로
#    공개 노출된다. 그 유닛의 EnvironmentFile 에는 아래 키만 넣고 거래 시크릿
#    (TOSS_*/KIWOOM_*/계좌번호)은 넣지 않는다. 통합 전에는 저장소가 갈려서
#    구조적으로 격리됐지만, 이제는 systemd 단위에서 지켜야 한다.

# --- FRED (세인트루이스 연준) : 필수 ---
# 쓰는 곳: 순유동성(WALCL-TGA-RRP), NFCI, 미 국채금리, 이벤트 캘린더 발표일정.
# 발급: https://fredaccount.stlouisfed.org/apikeys (무료, 즉시)
# 없으면: 캘린더 섹션 전체와 순유동성이 결측 처리된다.
FRED_API_KEY=

# --- EIA (미 에너지정보청) : 선택 ---
# [미사용 — 2026-08-26 확인] 소비 코드가 저장소에 없다(scripts/check_keys.py 의
# 존재 확인 항목으로만 남아 있다). 원유 재고 수집이 실제로 붙는 날 되살릴 것.
# 발급: https://www.eia.gov/opendata/register.php (무료, 즉시)
EIA_API_KEY=

# --- OpenRouter : 선택 (Phase 5.4 감시 서술 + Phase 7 리더보드) ---
# 쓰는 곳:
#  1) Phase 5.4 — 감시 경보를 사람이 읽을 문장으로 바꾸는 서술기
#     (`quant/adapters/narrate.py`). **판단이 아니라 서술만 한다** — 무엇을 경보할지는
#     `quant.control.health` 의 결정론적 함수가 정하고, 키가 없으면 조용히 결정론적
#     형식으로 떨어진다(경보 자체는 그대로 나간다).
#  2) Phase 7 — 무료 모델 N개를 Judgment 리더보드에 섀도우로 올릴 때.
# ":free" 모델은 토큰 단가가 0이라 크레딧이 차감되지 않는다.
# 검증: python3 scripts/check_keys.py (키 값을 출력하지 않고 도달만 확인)
OPENROUTER_API_KEY=

# 서술기 선택: claude(기본, 로컬 Claude Code CLI) | openrouter | none
OPS_NARRATOR=
# 모델 ID. 비우면 nvidia/nemotron-3-ultra-550b-a55b:free
# (2026-08-13 api/v1/models 실측: pricing 0/0, 컨텍스트 1,000,000).
# **웹 URL 에 보이는 날짜 접미사(-20260604)를 붙이지 않는다** — 실제 ID 에는 없고 404 다.
OPENROUTER_MODEL=

# DART OpenAPI (전자공시) — H-2 뉴스 고도화의 공시 축. https://opendart.fss.or.kr 무료 발급.
# 배당·잠정실적·유상증자 같은 팩트 이벤트를 뉴스보다 정확하게, robots 리스크 0 으로 받는다
# (네이버 공시 페이지는 robots.txt 전면 비허용 — 2026-08-16 실측, specs/2026-08-16-news-scale-design.md).
DART_API_KEY=

# 참고: KRX 키는 필요 없다. 한국 투자자별 매매는 네이버금융에서 키 없이 받는다.
# data.krx.co.kr 은 400 LOGOUT 으로 막혀 있다 (2026-08-12 실측).

# --- 분석 저장소 (MySQL, Phase 3) : 선택 ---
# 쓰는 곳: 뉴스↔종목↔리포트↔선정↔체결 관계 질의, 전방 수익률, 판단 리더보드.
# **거래 평면은 이 DB 를 모른다** — 09:15 에 MySQL 이 딸꾹질했다고 매매가 멈추면
# 안 된다. 엔진은 항상 로컬 JSONL 에 쓰고, 적재기가 장 마감 후에 옮긴다.
# MYSQL_DATABASE 가 비어 있으면 적재 자체를 건너뛴다(에러 아님).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=quant
MYSQL_PASSWORD=
MYSQL_DATABASE=

# --- 휘발성 캐시 (Redis, Phase 3b) : 선택 ---
# 쓰는 곳: 수집 중복 판정 집합(일 단위 TTL), 피드 건강도, 랭킹 캐시, 진행 중 집계.
# **돈이 걸린 상태는 절대 여기 두지 않는다** — 포지션·주문상태·control 플래그·
# 체결 원장은 재시작을 견뎌야 하고 Redis 는 그 보장을 하지 않는다. 파일이 진실이다.
# 비어 있으면 NullKeyValue 로 동작한다(에러 아님) — Redis 도입 이전과 똑같이 돈다.
REDIS_URL=

# 텔레그램에 보내는 리포트 링크의 베이스 주소. 기본값은 Tailscale Funnel 주소로,
# Tailscale 없이 **어디서든** 열린다(2026-08-19 교체 — 이전 기본값
# http://100.87.129.113:8899 은 Tailscale 네트워크 안에서만 열렸다).
# 링크 형식: <base>/YYYY/MM/DD/{KR|US}_{report|close_report}.html
REPORT_URL_BASE=https://ip-172-31-63-20.tailfee6e9.ts.net
